FROM kong:3.9.1
COPY kong.hybrid.yml /etc/kong/kong.yml
ENV KONG_DATABASE=off KONG_DECLARATIVE_CONFIG=/etc/kong/kong.yml \
    KONG_PROXY_LISTEN=0.0.0.0:8000 KONG_ADMIN_LISTEN=off KONG_STATUS_LISTEN=0.0.0.0:8100 \
    KONG_DNS_VALID_TTL=5 KONG_DNS_STALE_TTL=5 \
    KONG_PROXY_ACCESS_LOG=/dev/stdout KONG_PROXY_ERROR_LOG=/dev/stderr
