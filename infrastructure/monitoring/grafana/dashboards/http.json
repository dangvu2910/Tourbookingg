{
  "uid": "tourbooking-http", "title": "Tourbooking - HTTP and process", "schemaVersion": 39,
  "version": 1, "refresh": "15s", "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Requests per second", "type": "timeseries", "gridPos": {"x": 0,"y": 0,"w": 12,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "targets": [{"expr": "sum by (service) (rate(http_requests_received_total{job=\"app-metrics\"}[5m]))", "legendFormat": "{{service}}"}]},
    {"id": 2, "title": "HTTP status rates", "type": "timeseries", "gridPos": {"x": 12,"y": 0,"w": 12,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "targets": [{"expr": "sum by (service, code) (rate(http_requests_received_total{job=\"app-metrics\"}[5m]))", "legendFormat": "{{service}} {{code}}"}]},
    {"id": 3, "title": "HTTP latency p50 p95 p99", "type": "timeseries", "gridPos": {"x": 0,"y": 8,"w": 24,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "fieldConfig": {"defaults": {"unit": "s"}},
     "targets": [
       {"expr": "histogram_quantile(0.50, sum by (service, le) (rate(http_request_duration_seconds_bucket{job=\"app-metrics\"}[5m])))", "legendFormat": "{{service}} p50"},
       {"expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket{job=\"app-metrics\"}[5m])))", "legendFormat": "{{service}} p95"},
       {"expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_request_duration_seconds_bucket{job=\"app-metrics\"}[5m])))", "legendFormat": "{{service}} p99"}]},
    {"id": 4, "title": "Process working set", "type": "timeseries", "gridPos": {"x": 0,"y": 16,"w": 12,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "fieldConfig": {"defaults": {"unit": "bytes"}},
     "targets": [{"expr": "process_working_set_bytes{job=\"app-metrics\"}", "legendFormat": "{{service}} {{instance}}"}]},
    {"id": 5, "title": "Process CPU cores used", "type": "timeseries", "gridPos": {"x": 12,"y": 16,"w": 12,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "targets": [{"expr": "rate(process_cpu_seconds_total{job=\"app-metrics\"}[5m])", "legendFormat": "{{service}} {{instance}}"}]},
    {"id": 6, "title": "SQL outbox backlog (max across replicas)", "type": "timeseries", "gridPos": {"x": 0,"y": 24,"w": 12,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "targets": [{"expr": "max by (service) (tourbooking_outbox_pending{job=\"app-metrics\"})", "legendFormat": "{{service}}"}]},
    {"id": 7, "title": "RabbitMQ ready messages by node (cluster profile)", "type": "timeseries", "gridPos": {"x": 12,"y": 24,"w": 12,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "targets": [{"expr": "rabbitmq_queue_messages_ready{job=\"rabbitmq\"}", "legendFormat": "{{broker}}"}]},
    {"id": 8, "title": "Circuit breaker state (0 closed, 0.5 half-open, 1 open)", "type": "timeseries", "gridPos": {"x": 0,"y": 32,"w": 12,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "fieldConfig": {"defaults": {"min": 0, "max": 1, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
     "targets": [{"expr": "max by (service, target) (tourbooking_http_circuit_state{job=\"app-metrics\"})", "legendFormat": "{{service}} -> {{target}}"}]},
    {"id": 9, "title": "Circuit opened (last 1h)", "type": "stat", "gridPos": {"x": 12,"y": 32,"w": 12,"h": 8},
     "datasource": {"type": "prometheus","uid": "tourbooking-prometheus"},
     "targets": [{"expr": "sum by (service, target) (increase(tourbooking_http_circuit_opened_total{job=\"app-metrics\"}[1h]))", "legendFormat": "{{service}} -> {{target}}"}]},
    {"id": 10, "title": "Logs: warnings and errors (Loki)", "type": "logs", "gridPos": {"x": 0,"y": 40,"w": 24,"h": 12},
     "datasource": {"type": "loki","uid": "tourbooking-loki"},
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true},
     "targets": [{"expr": "{level=~\"Warning|Error|Critical\"} | json | line_format \"{{.service}} | {{.Category}} | {{.Message}}\"", "refId": "A"}]}
  ]
}
