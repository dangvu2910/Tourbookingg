@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Booking đã thay đổi - Voyager</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; background: #f5f7fb; color: #17243a; font-family: "Segoe UI", sans-serif; }
        main { width: 100%; max-width: 560px; padding: clamp(24px, 5vw, 40px); background: white; border-radius: 20px; box-shadow: 0 12px 36px #17243a12; }
        h1 { font-size: 26px; line-height: 1.4; }
        p { line-height: 1.7; }
        a { display: inline-block; margin-top: 12px; padding: 12px 20px; border-radius: 24px; background: #0d5bd8; color: white; text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>
    <main>
        <p>Voyager · Xung đột cập nhật (409)</p>
        <h1>Booking đã thay đổi ở một yêu cầu khác</h1>
        <p>Trang bạn đang mở không còn là phiên bản mới nhất. Thao tác vừa gửi chưa được áp dụng, để tránh ghi đè việc hủy, duyệt hoặc đổi lịch trước đó.</p>
        <p>Hãy tải lại danh sách, kiểm tra trạng thái hiện tại rồi thực hiện lại nếu cần.</p>
        <a href="@ViewData["ReloadUrl"]">Tải lại danh sách booking</a>
    </main>
</body>
</html>
