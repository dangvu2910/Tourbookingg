@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<h1 class="text-danger">Lỗi.</h1>
<h2 class="text-danger">Đã xảy ra lỗi trong quá trình xử lý yêu cầu.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Chế độ phát triển</h3>
<p>
    Chuyển sang môi trường <strong>Development</strong> sẽ hiển thị chi tiết lỗi.
</p>
<p>
    <strong>Không nên bật Development trên môi trường production.</strong>
    Việc này có thể làm lộ thông tin nhạy cảm.
    Khi debug trên máy, hãy set biến môi trường <strong>ASPNETCORE_ENVIRONMENT</strong> = <strong>Development</strong>
    và khởi động lại ứng dụng.
</p>
