<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tourbooking</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow">
            <div class="container">
                <div class="navbar-content">
                    <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">Voyager</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-lg-inline-flex justify-content-center">
                        @{
                            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        }
                        <ul class="navbar-nav navbar-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark nav-link-pill @(currentController == "Home" && currentAction == "Index" ? "is-active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark nav-link-pill @(currentController == "Tours" ? "is-active" : "")" href="/Tours">Tour</a>
                        </li>
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-pill @(currentController == "Admin" && currentAction == "Dashboard" ? "is-active" : "")" asp-area="" asp-controller="Admin" asp-action="Dashboard">Quản trị</a>
                            </li>
                        }
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark nav-link-pill @(currentController == "Account" && currentAction == "Reviews" ? "is-active" : "")" asp-area="" asp-controller="Account" asp-action="Reviews">Đánh giá</a>
                            </li>
                        }
                    </ul>
                        <div class="d-flex gap-2 align-items-center navbar-auth">
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                                var displayName = User.Identity?.Name ?? "Người dùng";
                                var initial = !string.IsNullOrWhiteSpace(displayName) ? displayName.Substring(0, 1).ToUpperInvariant() : "U";
                                <div class="dropdown user-menu">
                                    <button class="btn user-avatar dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @initial
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li class="px-3 py-2 small text-white">@displayName</li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li><a class="dropdown-item" href="/Admin/Dashboard">Dashboard Admin</a></li>
                                        }
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Hồ sơ</a>
                                        </li>
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Bookings">Đặt tour của tôi</a></li>
                                        <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index">Thông báo</a></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Reviews">Đánh giá của tôi</a>
                                        </li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-3 py-2">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-primary btn-sm w-100">Đăng xuất</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                        }
                        else
                        {
                            <div class="auth-pill">
                                <a class="btn btn-outline-primary btn-sm" href="/Account/Login">Đăng nhập</a>
                                <a class="btn btn-primary btn-sm" href="/Account/Register">Đăng ký</a>
                            </div>
                        }
                        </div>
                    </div>
                    <div class="navbar-contact ms-2">
                        <a class="btn btn-dark btn-sm" asp-controller="Home" asp-action="Contact">Liên hệ tư vấn</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (TempData["BookingSuccess"] is string bookingSuccess && !string.IsNullOrWhiteSpace(bookingSuccess))
    {
        <div class="toast-success" id="bookingSuccessToast">
            <div class="toast-icon">✓</div>
            <div>
                <strong>Đặt chuyến thành công</strong>
                <p>@bookingSuccess</p>
            </div>
        </div>
    }

    <footer class="bg-dark text-light py-5 mt-5">
        <div class="container">
            <div class="row mb-4">
                <div class="col-md-3">
                    <h5>Voyager</h5>
                    <p class="small text-white">Tái định nghĩa du lịch hiện đại với những hành trình được chọn lọc và đặt chỗ mượt mà.</p>
                </div>
                <div class="col-md-3">
                    <h5>Liên kết nhanh</h5>
                    <ul class="list-unstyled small">
                        <li><a href="/Tours" class="text-decoration-none text-white">Điểm đến</a></li>
                        <li><a href="#" class="text-decoration-none text-white">Lịch trình</a></li>
                        <li><a href="#" class="text-decoration-none text-white">Cẩm nang du lịch</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Công ty</h5>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="text-decoration-none text-white">Về chúng tôi</a></li>
                        <li><a href="#" class="text-decoration-none text-white">Chính sách bảo mật</a></li>
                        <li><a href="#" class="text-decoration-none text-white">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Bản tin</h5>
                    <p class="small text-white">Nhận gợi ý du lịch mới nhất trong hộp thư.</p>
                    <div class="input-group input-group-sm">
                        <input type="email" class="form-control" placeholder="Email">
                        <button class="btn btn-primary" type="button">→</button>
                    </div>
                </div>
            </div>
            <div class="border-top border-secondary pt-3 text-center small text-white">
                © 2026 The Ethereal Voyager. Bảo lưu mọi quyền. | 
                <a href="#" class="text-decoration-none text-white">ĐIỀU KHOẢN</a> | 
                <a href="#" class="text-decoration-none text-white">CHÍNH SÁCH COOKIE</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script>
        (function () {
            var toast = document.getElementById("bookingSuccessToast");
            if (!toast) {
                return;
            }

            toast.classList.add("is-visible");
            window.setTimeout(function () {
                toast.classList.remove("is-visible");
            }, 4500);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
