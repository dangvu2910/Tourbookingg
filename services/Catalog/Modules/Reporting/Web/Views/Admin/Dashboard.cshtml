@model Tourbooking.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "_AdminLayout";
    var vnd = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="dashboard-hero">
    <div>
        <h1>Tổng quan bảng điều khiển</h1>
        <p>Chào mừng quay lại. Đây là những gì đang diễn ra trên hệ sinh thái du lịch hôm nay.</p>
    </div>
    <div class="status-chip">Đang hoạt động</div>
</section>

<section class="stat-grid">
    <article class="stat-card">
        <div class="stat-icon">TO</div>
        <div>
            <p>Tổng số tour</p>
            <h2>@Model.TotalTours</h2>
        </div>
        <span class="stat-badge">+12%</span>
    </article>
    <article class="stat-card">
        <div class="stat-icon">BK</div>
        <div>
            <p>Tổng số đặt chỗ</p>
            <h2>@Model.TotalBookings</h2>
        </div>
        <span class="stat-badge">+24%</span>
    </article>
    <article class="stat-card">
        <div class="stat-icon">US</div>
        <div>
            <p>Tổng số người dùng</p>
            <h2>@Model.TotalUsers</h2>
        </div>
        <span class="stat-badge">+9%</span>
    </article>
</section>

<section class="dashboard-grid">
    <article class="panel-card">
        <div class="panel-header">
            <div>
                <h3>Xu hướng đặt chỗ</h3>
                <p>Tổng quan theo tháng về các đặt chỗ đã xác nhận</p>
            </div>
            <div class="segmented">
                <button class="is-active" type="button">Theo tháng</button>
                <button type="button">Theo tuần</button>
            </div>
        </div>
        <div class="chart-wrap">
            <div class="bar" style="height: 48%"><span>Thg 1</span></div>
            <div class="bar" style="height: 64%"><span>Thg 2</span></div>
            <div class="bar" style="height: 54%"><span>Thg 3</span></div>
            <div class="bar is-peak" style="height: 82%"><span>Thg 4</span></div>
            <div class="bar" style="height: 58%"><span>Thg 5</span></div>
            <div class="bar" style="height: 72%"><span>Thg 6</span></div>
        </div>
    </article>

    <article class="panel-card">
        <div class="panel-header">
            <div>
                <h3>Hoạt động gần đây</h3>
                <p>Cảnh báo và sự kiện mới nhất</p>
            </div>
            <a class="panel-link" href="#">Xem tất cả nhật ký</a>
        </div>
        <div class="activity-list">
            @foreach (var activity in Model.RecentActivities)
            {
                <div class="activity-item">
                    <div class="activity-dot"></div>
                    <div>
                        <strong>@activity.Title</strong>
                        <span>@activity.Description</span>
                    </div>
                </div>
            }
        </div>
    </article>
</section>

<section class="panel-card top-tours">
    <div class="panel-header">
        <div>
            <h3>Tour hiệu quả nhất</h3>
            <p>Những tour có hiệu suất và độ quan tâm cao</p>
        </div>
        <a class="panel-link" asp-controller="Tours" asp-action="Index">Quản lý tất cả</a>
    </div>

    <div class="tour-cards">
        @if (Model.TopTours.Any())
        {
            foreach (var tour in Model.TopTours)
            {
                <article class="tour-card">
                    <div class="tour-image">
                        @if (!string.IsNullOrWhiteSpace(tour.ImageUrl))
                        {
                            <img src="@Url.Content(tour.ImageUrl)" alt="@tour.Name" />
                        }
                        else
                        {
                            <div class="tour-placeholder"></div>
                        }
                    </div>
                    <div class="tour-body">
                        <h4>@tour.Name</h4>
                        <p>@tour.Location</p>
                        <span>@tour.Metric</span>
                    </div>
                </article>
            }
        }
        else
        {
            <article class="tour-card">
                <div class="tour-image">
                    <div class="tour-placeholder"></div>
                </div>
                <div class="tour-body">
                    <h4>Tour mẫu</h4>
                    <p>Đang chờ dữ liệu</p>
                    <span>@string.Format(vnd, "{0:C0}", 0)</span>
                </div>
            </article>
        }
    </div>
</section>
