@model Tour

@{
    ViewData["Title"] = "Cập nhật tour";
    Layout = "_AdminLayout";
}

<section class="dashboard-hero">
    <div>
        <p class="eyebrow">Hệ thống quản trị</p>
        <h1>Cập nhật tour</h1>
    </div>
</section>

<section class="panel-card">
    <form asp-action="Edit" asp-route-id="@Model.TourId" method="post" enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input type="hidden" asp-for="TourId" />

        <div class="admin-form-grid">
            <label>
                <span>Tên tour</span>
                <input asp-for="Name" type="text" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </label>
            <label>
                <span>Địa điểm</span>
                <input asp-for="Location" type="text" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </label>
            <label>
                <span>Giá</span>
                <input asp-for="Price" asp-format="{0:0}" class="price-input" type="text" inputmode="numeric" autocomplete="off" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </label>
            <label>
                <span>Danh mục</span>
                <input asp-for="CategoryId" type="text" />
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </label>
            <label style="grid-column: 1 / -1;">
                <span>Mô tả</span>
                <textarea asp-for="Description" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </label>
            <label style="grid-column: 1 / -1;">
                <span>Hình ảnh hiện tại</span>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div style="margin-top: 8px;">
                        <img src="@Model.ImageUrl" alt="Hình ảnh hiện tại" style="max-width: 300px; border: 1px solid #ddd; padding: 5px; border-radius: 12px;" />
                    </div>
                }
                else
                {
                    <span class="table-muted">Chưa có hình ảnh</span>
                }
            </label>
            <label style="grid-column: 1 / -1;">
                <span>Thay đổi hình ảnh</span>
                <input type="file" id="imageFile" name="imageFile" accept="image/*" />
                <span class="table-muted">Để trống nếu không muốn thay đổi hình ảnh</span>
            </label>
            <label style="grid-column: 1 / -1;">
                <span>Xem trước hình ảnh mới</span>
                <div id="imagePreview" style="margin-top: 8px;">
                    <img id="previewImage" src="" alt="Xem trước" style="max-width: 300px; display: none; border: 1px solid #ddd; padding: 5px; border-radius: 12px;" />
                </div>
            </label>
        </div>

        <div class="admin-form-actions">
            <a class="ghost-action" asp-controller="Admin" asp-action="Tours">Hủy</a>
            <button type="submit" class="primary-action">Lưu</button>
        </div>
    </form>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const imageInput = document.getElementById('imageFile');

        if (imageInput) {
            imageInput.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        const previewImage = document.getElementById('previewImage');
                        previewImage.src = event.target.result;
                        previewImage.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        const priceInput = document.querySelector('.price-input');
        const vndFormatter = new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 0 });

        const normalizePriceValue = (value) => value.replace(/\D/g, '');
        const formatPriceValue = (value) => {
            const digits = normalizePriceValue(value);
            return digits ? vndFormatter.format(Number(digits)) : '';
        };

        if (priceInput) {
            const form = priceInput.closest('form');

            priceInput.addEventListener('focus', () => {
                priceInput.value = normalizePriceValue(priceInput.value);
            });

            priceInput.addEventListener('blur', () => {
                priceInput.value = formatPriceValue(priceInput.value);
            });

            if (form) {
                form.addEventListener('submit', () => {
                    priceInput.value = normalizePriceValue(priceInput.value);
                });
            }

            priceInput.value = formatPriceValue(priceInput.value);
        }

        if (window.jQuery && window.jQuery.validator) {
            window.jQuery.validator.methods.number = function (value, element) {
                const raw = normalizePriceValue(value);
                return this.optional(element) || /^\d+$/.test(raw);
            };
        }
    </script>
}
