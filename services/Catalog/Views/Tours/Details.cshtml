@model Tour
@using Tourbooking.ViewModels

@{
    ViewData["Title"] = "Chi tiết tour";
    string NormalizeImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return "https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1600&q=80";
        }

        if (imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || imageUrl.StartsWith("~", StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }

        if (imageUrl.StartsWith("wwwroot/", StringComparison.OrdinalIgnoreCase))
        {
            return "/" + imageUrl.Substring("wwwroot/".Length).TrimStart('/');
        }

        if (imageUrl.StartsWith("/", StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl.Replace("\\", "/");
        }

        if (imageUrl.StartsWith("images/", StringComparison.OrdinalIgnoreCase))
        {
            return "/" + imageUrl.TrimStart('/');
        }

        return "/images/" + imageUrl.TrimStart('/');
    }

    string ResolveHeroImage()
    {
        var location = Model?.Location ?? string.Empty;
        var name = Model?.Name ?? string.Empty;

        if (location.Contains("Hội An", StringComparison.OrdinalIgnoreCase)
            || location.Contains("Hoi An", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Hội An", StringComparison.OrdinalIgnoreCase)
            || name.Contains("Hoi An", StringComparison.OrdinalIgnoreCase))
        {
            return "/images/839e713c-76f9-40d3-9764-758b56220ae0_hoian.webp";
        }

        return NormalizeImageUrl(Model?.ImageUrl);
    }

    var heroImage = ResolveHeroImage();
    var price = Model?.Price ?? 0;
    var vnd = CultureInfo.GetCultureInfo("vi-VN");
    var publicReviews = ViewData["PublicReviews"] as IEnumerable<PublicTourReviewRow> ?? Enumerable.Empty<PublicTourReviewRow>();
    var reviewCount = ViewData["ReviewCount"] as int? ?? 0;
    var averageRating = ViewData["AverageRating"] as double? ?? 0d;
}

<link rel="stylesheet" href="~/css/tour-details.css" asp-append-version="true" />

<div class="tour-details">
    <section class="tour-hero" style="background-image: url('@Url.Content(heroImage)');">
        <div class="tour-hero-overlay">
            <div class="tour-hero-content">
                <span class="tour-badge">HÀNH TRÌNH ĐẶC SẮC</span>
                <h1>@Model?.Name</h1>
                <div class="tour-meta">
                    <span>📍 @Model?.Location</span>
                    <span>•</span>
                    <span>4 ngày 3 đêm</span>
                </div>
            </div>
            <div class="tour-price-card">
                <strong>@price.ToString("C0", vnd)</strong>
                <small>/ người</small>
            </div>
        </div>
    </section>

    <section class="tour-content">
        <div class="tour-left">
            <div class="tour-section">
                <h2>Giới thiệu về tour</h2>
                <p>@(string.IsNullOrWhiteSpace(Model?.Description) ? "Chưa có mô tả chi tiết. Vui lòng liên hệ để biết thêm thông tin." : Model.Description)</p>
                <div class="tour-tags">
                    <span>Nghỉ dưỡng</span>
                    <span>Đi bộ nhẹ</span>
                    <span>Nửa ngày</span>
                    <span>4+ đêm</span>
                </div>
            </div>

            <div class="tour-section">
                <h3>Hành trình của bạn</h3>
                <div class="tour-journey">
                    <div class="journey-step">
                        <div class="step-index">01</div>
                        <div>
                            <h4>Đến nơi và nghỉ ngơi</h4>
                            <p>Đón tại sân bay và di chuyển về khu nghỉ dưỡng. Thưởng thức bữa tối và nghỉ ngơi.</p>
                        </div>
                    </div>
                    <div class="journey-step">
                        <div class="step-index">02</div>
                        <div>
                            <h4>Khám phá địa danh nổi bật</h4>
                            <p>Trọn vẹn ngày tham quan với hướng dẫn viên địa phương và thời gian tự do.</p>
                        </div>
                    </div>
                    <div class="journey-step">
                        <div class="step-index">03</div>
                        <div>
                            <h4>Thưởng thức văn hóa bản địa</h4>
                            <p>Trải nghiệm ẩm thực và văn hóa địa phương độc đáo.</p>
                        </div>
                    </div>
                    <div class="journey-step">
                        <div class="step-index">04</div>
                        <div>
                            <h4>Kết thúc hành trình</h4>
                            <p>Tự do mua sắm và trả phòng. Tiễn đoàn ra sân bay.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tour-section tour-review-section">
                <div class="tour-review-copy">
                    <span class="tour-review-kicker">Đánh giá chuyến đi</span>
                    <h3>Đã trải nghiệm tour này? Hãy để lại đánh giá.</h3>
                    <p>
                        Ý kiến của bạn giúp những người đi sau chọn tour phù hợp hơn và giúp chúng tôi cải thiện chất lượng dịch vụ.
                    </p>
                </div>
                <div class="tour-review-actions">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="review-button review-button-primary" asp-controller="Account" asp-action="Reviews" asp-route-tourId="@Model?.TourId">
                            Viết đánh giá ngay
                        </a>
                        <a class="review-button review-button-secondary" asp-controller="Account" asp-action="Bookings">
                            Xem các đặt chỗ của tôi
                        </a>
                    }
                    else
                    {
                        <a class="review-button review-button-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Reviews", "Account")">
                            Đăng nhập để đánh giá
                        </a>
                        <a class="review-button review-button-secondary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Bookings", "Account")">
                            Xem đặt chỗ sau khi đăng nhập
                        </a>
                    }
                </div>
            </div>

            <div class="tour-section tour-public-reviews">
                <div class="tour-public-reviews-header">
                    <div>
                        <span class="tour-review-kicker">Đánh giá công khai</span>
                        <h3>Khách đã đi nói gì về tour này</h3>
                        <p>@reviewCount đánh giá • @averageRating.ToString("0.0")/5 sao</p>
                    </div>
                </div>

                @if (publicReviews.Any())
                {
                    <div class="public-review-list">
                        @foreach (var review in publicReviews)
                        {
                            <article class="public-review-card">
                                <div class="public-review-top">
                                    <div>
                                        <strong>@review.ReviewerName</strong>
                                        <div class="public-review-stars">@string.Concat(Enumerable.Repeat("★", review.Rating))</div>
                                    </div>
                                    <small>@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small>
                                </div>
                                <h4>@review.Title</h4>
                                <p>@review.Content</p>
                                <div class="public-review-actions">
                                    <div class="review-votes" data-review-id="@review.ReviewId">
                                        <button class="vote-btn upvote @(review.UserVote == 1 ? "voted" : "")" data-value="1">
                                            👍 <span class="vote-count">@review.Upvotes</span>
                                        </button>
                                        <button class="vote-btn downvote @(review.UserVote == -1 ? "voted" : "")" data-value="-1">
                                            👎 <span class="vote-count">@review.Downvotes</span>
                                        </button>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <p class="mb-0">Chưa có đánh giá công khai nào cho tour này.</p>
                }
            </div>
        </div>

        <aside class="tour-right">
            <div class="tour-booking">
                <a class="book-button" asp-controller="Home" asp-action="Booking" asp-route-tourId="@Model?.TourId">Đặt ngay</a>
            </div>

            <div class="tour-guarantees tour-review-rail">
                <div class="guarantee-item">
                    <strong>Đánh giá khách thật</strong>
                    <span>Chỉ tour đã hoàn thành mới có thể review.</span>
                </div>
                <div class="guarantee-item">
                    <strong>Góp ý của bạn có giá trị</strong>
                    <span>Chia sẻ trải nghiệm để giúp tour tốt hơn.</span>
                </div>
            </div>

            <div class="tour-guarantees">
                <div class="guarantee-item">🛡️ Đặt tour an toàn</div>
                <div class="guarantee-item">✅ Hoàn hủy linh hoạt</div>
            </div>
        </aside>
    </section>
</div>

<form id="__antiForgeryForm">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script>
        (function(){
            function getToken(){
                var el = document.querySelector('#__antiForgeryForm input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            }

            async function vote(reviewId, value, button){
                var token = getToken();
                var form = new FormData();
                form.append('reviewId', reviewId);
                form.append('value', value);
                form.append('__RequestVerificationToken', token);

                var res = await fetch('@Url.Action("VoteReview", "Account")', {
                    method: 'POST',
                    body: form,
                    credentials: 'same-origin'
                });

                if (!res.ok) {
                    if (res.status === 401) {
                        window.location = '@Url.Action("Login", "Account")';
                        return;
                    }
                    return;
                }

                var data = await res.json();
                var container = document.querySelector('.review-votes[data-review-id="' + reviewId + '"]');
                if (!container) return;
                container.querySelector('.upvote .vote-count').textContent = data.upvotes;
                container.querySelector('.downvote .vote-count').textContent = data.downvotes;

                // update button states
                var upBtn = container.querySelector('.upvote');
                var downBtn = container.querySelector('.downvote');
                upBtn.classList.toggle('voted', data.userVote === 1);
                downBtn.classList.toggle('voted', data.userVote === -1);
            }

            document.addEventListener('click', function(e){
                var btn = e.target.closest('.vote-btn');
                if (!btn) return;
                var container = btn.closest('.review-votes');
                var reviewId = container.getAttribute('data-review-id');
                var value = btn.getAttribute('data-value');
                vote(reviewId, value, btn).catch(()=>{});
            });
        })();
    </script>
}
