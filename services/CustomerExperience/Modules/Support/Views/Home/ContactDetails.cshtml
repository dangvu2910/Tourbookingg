@model Tourbooking.ViewModels.ContactDetailsViewModel
@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = "Trò chuyện tư vấn";
    if (isAdmin) Layout = "_AdminLayout";
}
@await Html.PartialAsync("_Conversation", Model)
@section Scripts {
    @await Html.PartialAsync("_ConversationScripts", Model)
}
