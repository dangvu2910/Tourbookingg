@model Tourbooking.ViewModels.AdminContactsViewModel
@{ ViewData["Title"] = "Trò chuyện tư vấn"; Layout = "_AdminLayout"; }
<style>
.consult-inbox{display:grid;grid-template-columns:290px minmax(0,1fr);gap:18px;align-items:start}.consult-sidebar{background:#fff;border:1px solid #e2e8f0;border-radius:18px;overflow:hidden}.consult-sidebar header{padding:20px;border-bottom:1px solid #e2e8f0}.consult-sidebar h1{font-size:20px}.consult-filters{display:flex;gap:10px;font-size:13px;flex-wrap:wrap}.consult-threads{max-height:70vh;overflow:auto}.consult-thread{display:block;padding:16px 20px;color:#334155;text-decoration:none;border-bottom:1px solid #eef2f6}.consult-thread:hover,.consult-thread.selected{background:#e0f2fe;color:#075985}.consult-thread strong,.consult-thread span{display:block}.consult-thread span{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.consult-thread small{color:#64748b}.consult-inbox .support-chat{margin:0;max-width:none}.consult-inbox .support-head{padding:20px}.consult-inbox .support-messages{height:53vh}.consult-empty{padding:40px;color:#64748b;text-align:center}
@@media(max-width:900px){.consult-inbox{grid-template-columns:1fr}.consult-threads{max-height:220px}}
</style>
<div class="consult-inbox">
    <aside class="consult-sidebar">
        <header>
            <h1>Trò chuyện tư vấn</h1>
            <div class="consult-filters">
                <a href="/Admin/Contacts">Tất cả</a>
                <a href="/Admin/Contacts?status=Pending">Chờ trả lời</a>
                <a href="/Admin/Contacts?status=Replied">Đã trả lời</a>
            </div>
        </header>
        <nav class="consult-threads" aria-label="Danh sách hội thoại">
            @foreach (var contact in Model.Contacts)
            {
                <a class="consult-thread @(Model.Conversation?.Ticket.ContactInquiryId == contact.ContactInquiryId ? "selected" : "")" href="/Admin/Contacts?id=@contact.ContactInquiryId&status=@Model.SelectedStatus">
                    <strong>@contact.FullName</strong>
                    <span>@contact.Subject</span>
                    <span>@(contact.Status == "Pending" ? contact.Message : contact.AdminReply)</span>
                    <small>@(contact.Status == "Pending" ? "Chờ trả lời" : "Đã trả lời")</small>
                </a>
            }
            @if (!Model.Contacts.Any()) { <p class="consult-empty">Chưa có hội thoại.</p> }
        </nav>
    </aside>
    <div>
        @if (Model.Conversation != null)
        {
            @await Html.PartialAsync("_Conversation", Model.Conversation)
        }
        else
        {
            <div class="consult-empty">Chọn cuộc trò chuyện để bắt đầu tư vấn.</div>
        }
    </div>
</div>
@section Scripts {
    @if (Model.Conversation != null)
    {
        @await Html.PartialAsync("_ConversationScripts", Model.Conversation)
    }
}
