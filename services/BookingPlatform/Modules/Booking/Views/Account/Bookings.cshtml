@model Tourbooking.ViewModels.AccountBookingsViewModel

@{
    ViewData["Title"] = "Quản lý đặt chỗ";
    var vnd = CultureInfo.GetCultureInfo("vi-VN");
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/account-bookings.css" asp-append-version="true" />

<div class="profile-page">
    <div class="profile-shell">
        <aside class="profile-sidebar">
            <h2>Cài đặt</h2>
            <p class="profile-subtitle">Quản lý trải nghiệm du lịch của bạn</p>

            <nav class="profile-nav">
                <a class="profile-link" asp-action="Profile">Thông tin cá nhân</a>
                <a class="profile-link" asp-action="ChangePassword">Đổi mật khẩu</a>
                <a class="profile-link active" asp-action="Bookings">Quản lý đặt chỗ</a>
                <a class="profile-link" asp-action="Reviews">Đánh giá của tôi</a>
                <button class="profile-link" type="button">Thông báo</button>
                <button class="profile-link" type="button">Thanh toán</button>
            </nav>

            <form asp-controller="Account" asp-action="Logout" method="post" class="profile-logout">
                @Html.AntiForgeryToken()
                <button type="submit">Đăng xuất</button>
            </form>
        </aside>

        <section class="profile-main">
            <div class="profile-card">
                <div class="bookings-header">
                    <div>
                        <h3>Quản lý đặt chỗ</h3>
                        <p>Kiểm tra các tour bạn đã đặt và trạng thái hiện tại.</p>
                        @if (TempData["BookingSuccess"] is string bookingSuccess)
                        {
                            <p class="text-success mt-2">@bookingSuccess</p>
                        }
                        @if (TempData["BookingError"] is string bookingError)
                        {
                            <p class="text-danger mt-2">@bookingError</p>
                        }
                    </div>
                    <div class="bookings-tabs">
                        <a class="bookings-tab @(Model.CurrentTab == "all" ? "active" : "")" asp-action="Bookings" asp-route-tab="all">Tất cả (@Model.TotalBookings)</a>
                        <a class="bookings-tab @(Model.CurrentTab == "upcoming" ? "active" : "")" asp-action="Bookings" asp-route-tab="upcoming">Sắp tới (@Model.UpcomingBookings)</a>
                        <a class="bookings-tab @(Model.CurrentTab == "completed" ? "active" : "")" asp-action="Bookings" asp-route-tab="completed">Đã hoàn thành (@Model.CompletedBookings)</a>
                        <a class="bookings-tab @(Model.CurrentTab == "cancelled" ? "active" : "")" asp-action="Bookings" asp-route-tab="cancelled">Đã hủy (@Model.CancelledBookings)</a>
                    </div>
                </div>

                <div class="booking-list">
                    @if (Model.Bookings.Any())
                    {
                        foreach (var booking in Model.Bookings)
                        {
                            var statusClass = booking.Status switch
                            {
                                "Confirmed" => "confirmed",
                                "Cancelled" => "cancelled",
                                _ => "pending"
                            };
                            var statusLabel = booking.Status switch
                            {
                                "Confirmed" => "Đã xác nhận",
                                "Cancelled" => "Đã hủy",
                                _ => "Chờ xác nhận"
                            };

                            <article class="booking-item">
                                <div class="booking-thumb">
                                    @if (!string.IsNullOrWhiteSpace(booking.ImageUrl))
                                    {
                                        <img src="@Url.Content(booking.ImageUrl)" alt="@booking.TourName" />
                                    }
                                    else
                                    {
                                        <span>Chưa có ảnh</span>
                                    }
                                </div>
                                <div class="booking-info">
                                    <h4>@booking.TourName</h4>
                                    <p>📍 @booking.TourLocation</p>
                                    <div class="booking-meta">
                                        <span>Mã: VOY-@booking.BookingId</span>
                                        <span>Ngày đi: @booking.TravelDate.ToString("dd/MM/yyyy")</span>
                                        <span>@booking.GuestCount người</span>
                                    </div>
                                </div>
                                <div class="booking-price">
                                    <span>Tổng thanh toán</span>
                                    <strong>@booking.TotalPrice.ToString("C0", vnd)</strong>
                                    <span class="status-pill @statusClass">@statusLabel</span>

                                    @if (booking.OriginalTravelDate.HasValue)
                                    {
                                        <p class="booking-note">Đổi lịch từ @booking.OriginalTravelDate.Value.ToString("dd/MM/yyyy")</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(booking.RescheduleNote))
                                    {
                                        <p class="booking-note">Ghi chú: @booking.RescheduleNote</p>
                                    }
                                    @if (booking.CancelledAt.HasValue && !string.IsNullOrWhiteSpace(booking.CancelReason))
                                    {
                                        <p class="booking-note">Lý do hủy: @booking.CancelReason</p>
                                    }

                                    @if (booking.CanReschedule)
                                    {
                                        <details class="booking-action-toggle">
                                            <summary class="btn btn-outline">Đổi lịch</summary>
                                            <form asp-action="RescheduleBooking" method="post" class="booking-action">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                <label class="booking-action-label">
                                                    Ngày đi mới
                                                    <input class="form-control" type="date" name="newTravelDate" min="@booking.MinAllowedDateIso" required />
                                                </label>
                                                <label class="booking-action-label">
                                                    Ghi chú (tuỳ chọn)
                                                    <input class="form-control" type="text" name="note" maxlength="500" />
                                                </label>
                                                <button type="submit" class="btn btn-outline">Gửi yêu cầu</button>
                                            </form>
                                        </details>
                                    }

                                    @if (booking.CanCancel)
                                    {
                                        <details class="booking-action-toggle">
                                            <summary class="btn btn-outline">Hủy</summary>
                                            <form asp-action="CancelBooking" method="post" class="booking-action">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                                <label class="booking-action-label">
                                                    Lý do hủy
                                                    <input class="form-control" type="text" name="reason" maxlength="500" required />
                                                </label>
                                                <button type="submit" class="btn btn-outline">Xác nhận hủy</button>
                                            </form>
                                        </details>
                                    }

                                    @if (string.Equals(booking.Status, "Completed", StringComparison.OrdinalIgnoreCase) || booking.TravelDate.Date < DateTime.Today)
                                    {
                                        <a class="btn btn-sm btn-primary mt-3" asp-action="Reviews">Đánh giá tour</a>
                                    }
                                </div>
                            </article>
                        }
                    }
                    else
                    {
                        <p>Bạn chưa có đặt chỗ nào. Hãy khám phá tour mới ngay!</p>
                    }
                </div>
            </div>
        </section>
    </div>
</div>
