@model Tourbooking.ViewModels.AdminUsersViewModel

@{
    ViewData["Title"] = "Người dùng";
    Layout = "_AdminLayout";
}

<section class="dashboard-hero">
    <div>
        <p class="eyebrow">Hệ thống quản trị</p>
        <h1>Quản lý người dùng</h1>
    </div>
    <div class="hero-actions">
        <button type="button" class="ghost-action" id="export-users" data-export-url="@Url.Action("ExportUsers", "Admin")">Xuất báo cáo</button>
        <a class="primary-action" asp-controller="Admin" asp-action="CreateUser">Thêm người dùng mới</a>
    </div>
</section>

<section class="panel-card">
    <div class="table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Người dùng</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Ngày gia nhập</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar">@user.Initials</div>
                                <div class="user-meta">
                                    <strong>@user.Name</strong>
                                </div>
                            </div>
                        </td>
                        <td class="table-muted">@user.Email</td>
                        <td>
                            @{ var roleLabel = user.Role == "Admin" ? "Quản trị" : "Người dùng"; }
                            <span class="role-pill @(user.Role == "Admin" ? "admin" : "user")">@roleLabel</span>
                        </td>
                        <td>@user.JoinedDate</td>
                        <td>
                            @{ var statusLabel = user.Status == "Active" ? "Đang hoạt động" : "Tạm dừng"; }
                            <span class="status-text @(user.Status == "Active" ? "active" : "paused")">@statusLabel</span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a class="icon-button" asp-action="EditUser" asp-route-id="@user.Id" title="Chỉnh sửa">✎</a>
                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="inline-form" onsubmit="return confirm('Bạn chắc chắn muốn xóa người dùng này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="icon-button is-danger" title="Xóa">🗑</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        @{
            var startIndex = Model.TotalUsers == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
            var endIndex = Model.TotalUsers == 0 ? 0 : Model.CurrentPage * Model.PageSize;
            if (endIndex > Model.TotalUsers)
            {
                endIndex = Model.TotalUsers;
            }
        }
        <span>Hiển thị @startIndex-@endIndex của @Model.TotalUsers người dùng</span>
        <div class="pager">
            @if (Model.CurrentPage > 1)
            {
                <a class="page-btn" asp-action="Users" asp-route-page="@(Model.CurrentPage - 1)">‹</a>
            }
            else
            {
                <span class="page-btn is-disabled">‹</span>
            }
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <a class="page-btn @(i == Model.CurrentPage ? "is-active" : "")" asp-action="Users" asp-route-page="@i">@i</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="page-btn" asp-action="Users" asp-route-page="@(Model.CurrentPage + 1)">›</a>
            }
            else
            {
                <span class="page-btn is-disabled">›</span>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const exportButton = document.getElementById('export-users');

        const downloadFallback = (url) => {
            window.location.href = url;
        };

        const pad2 = (value) => String(value).padStart(2, '0');

        if (exportButton) {
            exportButton.addEventListener('click', async () => {
                const url = exportButton.getAttribute('data-export-url');
                if (!url) {
                    return;
                }

                if (!window.showSaveFilePicker) {
                    downloadFallback(url);
                    return;
                }

                try {
                    const now = new Date();
                    const stamp = `${now.getFullYear()}${pad2(now.getMonth() + 1)}${pad2(now.getDate())}-${pad2(now.getHours())}${pad2(now.getMinutes())}${pad2(now.getSeconds())}`;
                    const suggestedName = `users-report-${stamp}.xlsx`;
                    const handle = await window.showSaveFilePicker({
                        suggestedName,
                        types: [
                            {
                                description: 'Excel Workbook',
                                accept: {
                                    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': ['.xlsx']
                                }
                            }
                        ]
                    });

                    const response = await fetch(url, { credentials: 'same-origin' });
                    if (!response.ok) {
                        throw new Error('Export failed');
                    }

                    const blob = await response.blob();
                    const writable = await handle.createWritable();
                    await writable.write(blob);
                    await writable.close();
                } catch (error) {
                    if (error && error.name === 'AbortError') {
                        return;
                    }
                    downloadFallback(url);
                }
            });
        }
    </script>
}
