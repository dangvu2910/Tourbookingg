@model Tourbooking.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="profile-page">
    <div class="profile-shell">
        <aside class="profile-sidebar">
            <h2>Cài đặt</h2>
            <p class="profile-subtitle">Quản lý trải nghiệm du lịch của bạn</p>

            <nav class="profile-nav">
                <a class="profile-link" asp-action="Profile">Thông tin cá nhân</a>
                <a class="profile-link active" asp-action="ChangePassword">Đổi mật khẩu</a>
                <a class="profile-link" asp-action="Bookings">Quản lý đặt chỗ</a>
                <button class="profile-link" type="button">Thông báo</button>
                <button class="profile-link" type="button">Thanh toán</button>
            </nav>

            <form asp-controller="Account" asp-action="Logout" method="post" class="profile-logout">
                @Html.AntiForgeryToken()
                <button type="submit">Đăng xuất</button>
            </form>
        </aside>

        <section class="profile-main">
            <form asp-action="ChangePassword" method="post" class="profile-card">
                @Html.AntiForgeryToken()
                <div class="profile-header">
                    <div>
                        <h3>Đổi mật khẩu</h3>
                        <p>Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>
                        @if (TempData["ChangePasswordMessage"] is string message)
                        {
                            <p class="text-success mt-2">@message</p>
                        }
                    </div>
                    <div class="profile-actions">
                        <a class="btn-outline" asp-action="ChangePassword">Hủy</a>
                        <button class="btn-primary" type="submit">Lưu thay đổi</button>
                    </div>
                </div>

                <div class="profile-form">
                    <label>
                        <span>Mật khẩu hiện tại</span>
                        <input asp-for="CurrentPassword" type="password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </label>
                    <label>
                        <span>Mật khẩu mới</span>
                        <input asp-for="NewPassword" type="password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </label>
                    <label>
                        <span>Xác nhận mật khẩu mới</span>
                        <input asp-for="ConfirmPassword" type="password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </label>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
