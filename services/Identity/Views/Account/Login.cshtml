@model Tourbooking.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập - Tourbooking";
    Layout = "_LayoutLogin";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="login-container">
    <div class="login-content">
        <!-- Left Side: Background -->
        <div class="login-side login-left">
            <div class="login-overlay">
                <h1>Voyager</h1>
                <p>Gợi ý hành trình của bạn qua những phong cảnh đầy chất thơ trên thế giới.</p>
                
                <div class="inspiration">
                    <p class="quote">"Du lịch là thứ duy nhất bạn mua mà làm bạn giàu lên."</p>
                    <div class="author-info">
                        <img src="https://via.placeholder.com/40" alt="Tác giả" class="author-avatar">
                        <span>Elena S, Trưởng bộ phận tour</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="login-side login-right">
            <div class="login-form-wrapper">
                <h2>Chào mừng quay lại</h2>
                <p class="subtitle">Vui lòng nhập thông tin để truy cập tài khoản.</p>

                <form asp-action="Login" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Email Input -->
                    <div class="form-group">
                                <label for="email">Địa chỉ email</label>
                                    <input asp-for="Email" class="form-control" placeholder="ví dụ: traveler@voyager.com" />
                           <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="form-group">
                        <div class="password-header">
                            <label for="password">Mật khẩu</label>
                            <a href="#" class="forgot-password">Quên mật khẩu?</a>
                        </div>
                           <input asp-for="Password" class="form-control" placeholder="••••••••" />
                           <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Remember Me -->
                    <div class="form-group checkbox-group">
                        <input asp-for="RememberMe" />
                        <label asp-for="RememberMe">Ghi nhớ đăng nhập trong 30 ngày</label>
                    </div>

                    <!-- Sign In Button -->
                    <button type="submit" class="btn-signin">Đăng nhập Voyager</button>

                    <!-- Divider -->
                    <div class="divider">Hoặc tiếp tục với</div>

                    <!-- Social Login -->
                    <div class="social-login">
                        <a href="#" class="social-btn google-btn">
                            <img src="https://www.google.com/favicon.ico" alt="Google">
                            Google
                        </a>
                        <a href="#" class="social-btn apple-btn">
                            <img src="https://www.apple.com/favicon.ico" alt="Apple">
                            Apple
                        </a>
                    </div>

                    <!-- Sign Up Link -->
                    <p class="signup-link">
                        Chưa có tài khoản? <a asp-action="Register" asp-controller="Account">Đăng ký</a>
                    </p>
                </form>

                <!-- Footer -->
                <div class="login-footer">
                    <p>© 2024 Voyager. Bảo lưu mọi quyền.</p>
                    <div class="footer-links">
                        <a href="#">Chính sách bảo mật</a>
                        <span>•</span>
                        <a href="#">Điều khoản</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
