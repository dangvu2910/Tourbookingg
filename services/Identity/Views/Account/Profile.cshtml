@model Tourbooking.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="profile-page">
    <div class="profile-shell">
        <aside class="profile-sidebar">
            <h2>Cài đặt</h2>
            <p class="profile-subtitle">Quản lý trải nghiệm du lịch của bạn</p>

            <nav class="profile-nav">
                <a class="profile-link active" asp-action="Profile">Thông tin cá nhân</a>
                <a class="profile-link" asp-action="ChangePassword">Đổi mật khẩu</a>
                <a class="profile-link" asp-action="Bookings">Quản lý đặt chỗ</a>
                <button class="profile-link" type="button">Thông báo</button>
                <button class="profile-link" type="button">Thanh toán</button>
            </nav>

            <form asp-controller="Account" asp-action="Logout" method="post" class="profile-logout">
                @Html.AntiForgeryToken()
                <button type="submit">Đăng xuất</button>
            </form>
        </aside>

        <section class="profile-main">
            <form asp-action="Profile" method="post" class="profile-card">
                @Html.AntiForgeryToken()
                <div class="profile-header">
                    <div class="profile-avatar">
                        <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=200&q=80" alt="Ảnh đại diện" />
                    </div>
                    <div>
                        <h3>Thông tin cá nhân</h3>
                        <p>Cập nhật thông tin để Voyager phục vụ bạn tốt hơn.</p>
                        @if (TempData["ProfileMessage"] is string message)
                        {
                            <p class="text-success mt-2">@message</p>
                        }
                    </div>
                    <div class="profile-actions">
                        <a class="btn-outline" asp-action="Profile">Hủy</a>
                        <button class="btn-primary" type="submit">Lưu thay đổi</button>
                    </div>
                </div>

                <div class="profile-form">
                    <label>
                        <span>Họ và tên</span>
                        <input asp-for="FullName" type="text" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </label>
                    <label>
                        <span>Email liên hệ</span>
                        <input asp-for="Email" type="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </label>
                    <label>
                        <span>Số điện thoại</span>
                        <input asp-for="PhoneNumber" type="text" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </label>
                    <label>
                        <span>Địa chỉ</span>
                        <input asp-for="Address" type="text" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </label>
                </div>

                <div class="profile-preferences">
                    <div>
                        <h4>Ưu tiên trải nghiệm</h4>
                        <p>Chọn các loại hình du lịch yêu thích để cá nhân hóa hành trình.</p>
                    </div>
                    <div class="profile-tags">
                        <button type="button" class="tag active">Nghỉ dưỡng</button>
                        <button type="button" class="tag">Khám phá</button>
                        <button type="button" class="tag active">Ẩm thực</button>
                        <button type="button" class="tag">Văn hóa</button>
                    </div>
                </div>
            </form>

            <div class="profile-card profile-alert">
                <div class="alert-icon">🔒</div>
                <div>
                    <h4>Xác thực hai yếu tố (2FA)</h4>
                    <p>Tăng cường bảo mật cho tài khoản Voyager của bạn.</p>
                </div>
                <button class="btn-link" type="button">Thiết lập ngay</button>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
