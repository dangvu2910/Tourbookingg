@model Tourbooking.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký - Tourbooking";
    Layout = "_LayoutLogin";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="login-container">
    <div class="login-content">
        <div class="login-side login-left">
            <div class="login-overlay">
                <h1>Voyager</h1>
                <p>Tạo tài khoản để bắt đầu đặt tour.</p>
            </div>
        </div>

        <div class="login-side login-right">
            <div class="login-form-wrapper">
                <h2>Tạo tài khoản</h2>
                <p class="subtitle">Nhập thông tin để bắt đầu.</p>

                <form asp-action="Register" asp-controller="Account" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" placeholder="ban@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" placeholder="Tạo mật khẩu" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Xác nhận mật khẩu" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn-signin">Tạo tài khoản</button>

                    <p class="signup-link">
                        Đã có tài khoản? <a asp-action="Login" asp-controller="Account">Đăng nhập</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
