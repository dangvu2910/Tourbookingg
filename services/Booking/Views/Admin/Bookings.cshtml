@model Tourbooking.ViewModels.AdminBookingsViewModel

@{
    ViewData["Title"] = "Đặt chỗ";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-bookings.css" asp-append-version="true" />
}
<section class="bookings-hero">
    <div>
        <h1>Quản lý đặt chỗ</h1>
        <p>Rà soát và quản lý các đặt chỗ tour gần đây.</p>
    </div>
    <button class="primary-action" type="button" id="export-bookings" data-export-url="@Url.Action("ExportBookingsExcel", "Admin")">Xuất báo cáo</button>
</section>

<section class="stat-grid">
    <article class="stat-card">
        <div class="stat-title">
            <div class="stat-icon">BK</div>
            Tổng số đặt chỗ
        </div>
        <div class="stat-value">@Model.TotalBookings</div>
        <div class="stat-meta">Tổng số đặt chỗ hiện có</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">
            <div class="stat-icon">RV</div>
            Doanh thu
        </div>
        <div class="stat-value">@Model.Revenue</div>
        <div class="stat-meta">Tổng doanh thu đã ghi nhận</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">
            <div class="stat-icon">AT</div>
            Tỉnh
        </div>
        <div class="stat-value">@Model.ActiveTours</div>
        <div class="stat-meta">Số tỉnh/thành có tour</div>
    </article>
    <article class="stat-card">
        <div class="stat-title">
            <div class="stat-icon">AG</div>
            Số người
        </div>
        <div class="stat-value">@Model.AverageGroupSize</div>
        <div class="stat-meta">Trung bình mỗi đặt chỗ</div>
    </article>
</section>

@section Scripts {
    <script>
        const exportButton = document.getElementById('export-bookings');

        const downloadFallback = (url) => {
            window.location.href = url;
        };

        const pad2 = (value) => String(value).padStart(2, '0');

        if (exportButton) {
            exportButton.addEventListener('click', async () => {
                const url = exportButton.getAttribute('data-export-url');
                if (!url) {
                    return;
                }

                if (!window.showSaveFilePicker) {
                    downloadFallback(url);
                    return;
                }

                try {
                    const now = new Date();
                    const stamp = `${now.getFullYear()}${pad2(now.getMonth() + 1)}${pad2(now.getDate())}-${pad2(now.getHours())}${pad2(now.getMinutes())}${pad2(now.getSeconds())}`;
                    const suggestedName = `bookings-report-${stamp}.xlsx`;
                    const handle = await window.showSaveFilePicker({
                        suggestedName,
                        types: [
                            {
                                description: 'Excel Workbook',
                                accept: {
                                    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': ['.xlsx']
                                }
                            }
                        ]
                    });

                    const response = await fetch(url, { credentials: 'same-origin' });
                    if (!response.ok) {
                        throw new Error('Export failed');
                    }

                    const blob = await response.blob();
                    const writable = await handle.createWritable();
                    await writable.write(blob);
                    await writable.close();
                } catch (error) {
                    if (error && error.name === 'AbortError') {
                        return;
                    }
                    downloadFallback(url);
                }
            });
        }

        const statusClassMap = {
            PendingConfirmation: 'is-yellow',
            Confirmed: 'is-green',
            Cancelled: 'is-red'
        };

        const updateStatusClass = (select) => {
            if (!select) {
                return;
            }
            select.classList.remove('is-yellow', 'is-green', 'is-red');
            const value = select.value || select.dataset.status || 'PendingConfirmation';
            const className = statusClassMap[value] || 'is-yellow';
            select.classList.add(className);
        };

        document.querySelectorAll('.status-select').forEach((select) => {
            updateStatusClass(select);
            select.addEventListener('change', () => updateStatusClass(select));
        });
    </script>
}

<section class="panel-card">
    <div class="panel-header">
        <div>
                <h3>Đặt chỗ gần đây</h3>
                <p>Hoạt động mới nhất trong quy trình đặt chỗ</p>
        </div>
        <div class="table-actions">
                <form method="get" asp-action="Bookings" asp-controller="Admin" class="filter-inline">
                    <select name="status" aria-label="Lọc theo trạng thái">
                        <option value="">Tất cả trạng thái</option>
                        @foreach (var status in Model.Statuses)
                        {
                            var label = status == "PendingConfirmation"
                                ? "Chờ xác nhận"
                                : status == "Confirmed"
                                    ? "Đã xác nhận"
                                    : "Đã hủy";
                            <option value="@status" selected="@(status == Model.SelectedStatus)">@label</option>
                        }
                    </select>
                    <button type="submit">Lọc</button>
                </form>
        </div>
    </div>

    <div class="table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Tên tour</th>
                    <th>Ngày</th>
                    <th>Số lượng</th>
                    <th>Tổng giá</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.RecentBookings)
                {
                    <tr>
                        <td>
                            <div class="user-cell">
                                <div class="user-avatar">@booking.CustomerInitials</div>
                                <div class="user-meta">
                                    <strong>@booking.CustomerName</strong>
                                    <span>@booking.CustomerEmail</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="table-title">@booking.TourName</div>
                        </td>
                        <td>@booking.Date</td>
                        <td>@booking.Quantity</td>
                        <td class="table-strong">@booking.TotalPrice</td>
                        <td>
                            @{
                                var currentStatus = booking.Status;
                                if (string.Equals(currentStatus, "Pending", StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(currentStatus, "Processing", StringComparison.OrdinalIgnoreCase))
                                {
                                    currentStatus = "PendingConfirmation";
                                }
                            }
                            <form asp-action="UpdateBookingStatus" asp-route-id="@booking.BookingId" method="post" class="status-form">
                                @Html.AntiForgeryToken()
                                <select name="status" aria-label="Trạng thái đặt chỗ" class="status-select @(currentStatus == "Confirmed" ? "is-green" : currentStatus == "Cancelled" ? "is-red" : "is-yellow")" data-status="@currentStatus">
                                    <option value="PendingConfirmation" selected="@(currentStatus == "PendingConfirmation")">Chờ xác nhận</option>
                                    <option value="Confirmed" selected="@(currentStatus == "Confirmed")">Đã xác nhận</option>
                                    <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Đã hủy</option>
                                </select>
                                <button type="submit" class="ghost-action">Lưu</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        @{
            var startIndex = Model.TotalBookings == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
            var endIndex = Model.TotalBookings == 0 ? 0 : Model.CurrentPage * Model.PageSize;
            if (endIndex > Model.TotalBookings)
            {
                endIndex = Model.TotalBookings;
            }
        }
        <span>Hiển thị @startIndex-@endIndex của @Model.TotalBookings đặt chỗ</span>
        <div class="pager">
            @if (Model.CurrentPage > 1)
            {
                <a class="page-btn" asp-action="Bookings" asp-route-status="@Model.SelectedStatus" asp-route-page="@(Model.CurrentPage - 1)">‹</a>
            }
            else
            {
                <span class="page-btn is-disabled">‹</span>
            }
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <a class="page-btn @(i == Model.CurrentPage ? "is-active" : "")" asp-action="Bookings" asp-route-status="@Model.SelectedStatus" asp-route-page="@i">@i</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a class="page-btn" asp-action="Bookings" asp-route-status="@Model.SelectedStatus" asp-route-page="@(Model.CurrentPage + 1)">›</a>
            }
            else
            {
                <span class="page-btn is-disabled">›</span>
            }
        </div>
    </div>
</section>
