# Generate a private .env using scripts/Initialize-Environment.ps1.
SQL_PASSWORD=ReplaceWithYourStrongPassword!9
RABBITMQ_PASSWORD=ReplaceWithYourStrongPassword!9
ADMIN_EMAIL=admin@tourbooking.local
ADMIN_PASSWORD=ReplaceWithYourStrongPassword!9

# Generated by Initialize-Environment.ps1; required for private service APIs.
INTERNAL_SERVICE_KEY=

# Hybrid stack: generated automatically without replacing existing credentials.
IDENTITY_SQL_PASSWORD=
CATALOG_SQL_PASSWORD=
BOOKING_SQL_PASSWORD=
CUSTOMER_SQL_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_CHAT_PASSWORD=
MONGO_NOTIFICATION_PASSWORD=
HYBRID_ADMIN_PASSWORD=

# Compose project of the live hybrid stack (volumes are named after it; do not change once data exists).
HYBRID_PROJECT_NAME=tourbooking-hybrid
HYBRID_SEED_DEMO=true

API_JWT_SIGNING_KEY=
