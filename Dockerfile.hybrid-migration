FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish tools/HybridMigration/HybridMigration.csproj -c Release -o /migration -m:1
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /migration
COPY --from=build /migration .
ENTRYPOINT ["dotnet", "HybridMigration.dll"]
